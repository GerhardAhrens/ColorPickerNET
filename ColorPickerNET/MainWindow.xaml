<Window
    x:Class="ColorPickerNET.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ColorPickerNET"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ColorPickerNET"
    Width="370"
    Height="200"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="22" />
            <RowDefinition Height="22" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="lblCurrentHTMLColor"
                   Grid.Row="1"
                   Grid.Column="0"
                   Margin="5,0,5,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Text="Aktuelle Farbe HTML" />

        <TextBox x:Name="txtCurrentHTMLColor"
                 Grid.Row="1"
                 Grid.Column="1"
                 VerticalAlignment="Center"
                 IsReadOnly="True"
                 Text="_" />

        <TextBlock x:Name="lblCurrentRGBColor"
                   Grid.Row="2"
                   Grid.Column="0"
                   Margin="5,0,5,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Text="Aktuelle Farbe RGB" />

        <TextBox x:Name="txtCurrentRGBColor"
                 Grid.Row="2"
                 Grid.Column="1"
                 VerticalAlignment="Center"
                 IsReadOnly="True"
                 Text="_" />

        <TextBlock x:Name="lblCurrentAColor"
                   Grid.Row="3"
                   Grid.Column="0"
                   Margin="5,0,5,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Text="Alpha Kanal" />

        <TextBox x:Name="txtCurrentAColor"
                 Grid.Row="3"
                 Grid.Column="1"
                 VerticalAlignment="Center"
                 IsReadOnly="True"
                 Text="_" />

        <TextBlock x:Name="lblCurrentIntColor"
                   Grid.Row="4"
                   Grid.Column="0"
                   Margin="5,0,5,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Text="Win32 Color" />

        <TextBox x:Name="txtCurrentIntColor"
                 Grid.Row="4"
                 Grid.Column="1"
                 VerticalAlignment="Center"
                 IsReadOnly="True"
                 Text="_" />

        <Rectangle x:Name="shapeColorDisplay"
                   Grid.Row="1"
                   Grid.RowSpan="4"
                   Grid.Column="2"
                   Height="90"
                   Margin="15,0,15,0"
                   VerticalAlignment="Top"
                   Stroke="Black"
                   StrokeThickness="2" />

        <TextBlock x:Name="lblDescription"
                   Grid.Row="5"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   Margin="5"
                   VerticalAlignment="Bottom"
                   Text="HTML-Farbecode mit F2 in Zwischenablage" />

        <TextBlock x:Name="lblDescriptionWin32"
                   Grid.Row="6"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   Margin="5"
                   VerticalAlignment="Bottom"
                   Text="Win32-Farbecode mit F3 in Zwischenablage" />
        <Button
            x:Name="btnClose"
            Grid.Row="5"
            Grid.RowSpan="2"
            Grid.Column="3"
            Width="60"
            Height="30"
            Margin="0,0,5,5"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Content="Beenden" />
    </Grid>
</Window>
